# Пример переменных окружения интеграции с Bitrix24.
#
# Скопируйте файл в `.env` для локальной разработки и заполните значения.
# `.env` в репозиторий не попадает — он в .gitignore (ТЗ 8, 9).
# На проде значения задаются в Vercel: Project → Settings → Environment Variables.

# ── Обязательно ──────────────────────────────────────────────────────────────

# Вебхук входящего запроса Bitrix24. Как его получить — docs/bitrix24.md.
# Формат: https://<портал>.bitrix24.kz/rest/<id пользователя>/<токен>/
BITRIX_WEBHOOK_URL=https://bs-holding.bitrix24.kz/rest/1/k43cms9nnyj91p69/

# ── Необязательно ────────────────────────────────────────────────────────────

# Источник лида в CRM. WEB — стандартное значение «Сайт».
BITRIX_SOURCE_ID=WEB

# ID сотрудника, на которого назначать лиды. Пусто — Bitrix24 распределит сам.
BITRIX_ASSIGNED_BY_ID=

# Какой источник уходит в стандартные UTM-поля: first (по умолчанию) или last.
# Второй источник в любом случае виден в комментарии карточки.
BITRIX_UTM_PRIORITY=first

# Таймаут запроса к порталу и число повторов при временных сбоях.
BITRIX_TIMEOUT_MS=8000
BITRIX_RETRIES=2

# Лимит отправок с одного адреса: «количество/секунды».
LEAD_RATE_LIMIT=10/60

# Разрешённые источники запросов через запятую. Пусто — принимаются запросы
# с того же домена, на котором работает сайт (включая превью-деплои).
LEAD_ALLOWED_ORIGINS=

# ── Пользовательские поля Bitrix24 ───────────────────────────────────────────
#
# Пока переменная не задана, значение уходит в структурированный комментарий
# карточки лида и не теряется. Создали поле в CRM — впишите его код сюда.
# Код поля выглядит как UF_CRM_1712345678 (см. docs/bitrix24.md, шаг 4).

# BITRIX_UF_FORM_CODE=
# BITRIX_UF_FORM_TITLE=
# BITRIX_UF_CITY=
# BITRIX_UF_PROJECT=
# BITRIX_UF_CTA_LOCATION=
# BITRIX_UF_PAGE_URL=
# BITRIX_UF_PAGE_TITLE=
# BITRIX_UF_LANG=
# BITRIX_UF_SUBMISSION_ID=
# BITRIX_UF_FIRST_SOURCE=
# BITRIX_UF_LAST_SOURCE=

# Отдельные значения форм. Ключ слота — из данных заявки, например
# quiz_rooms → BITRIX_UF_DETAIL_QUIZ_ROOMS.
# BITRIX_UF_DETAIL_QUIZ_ROOMS=
# BITRIX_UF_DETAIL_QUIZ_FLOOR=
# BITRIX_UF_DETAIL_QUIZ_PAYMENT=
# BITRIX_UF_DETAIL_LAYOUT_NAME=
# BITRIX_UF_DETAIL_CALC_TOTAL=
